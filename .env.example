# Copy to .env and restrict it before filling anything in:
#   cp .env.example .env
#   chmod 600 .env
# HomeBase refuses to load a .env that is group- or world-readable.
# Blank lines and comments are ignored. Do not put real secrets in this file.

# Ledger location. Unset uses ~/.local/share/homebase/homebase.db
# HOMEBASE_DATA_DIR=
# HOMEBASE_DB=

# Push notifications omit dollar amounts unless this is 1, true, yes, or on.
# HOMEBASE_NOTIFY_AMOUNTS=0
# HOMEBASE_NTFY_URL=
# HOMEBASE_NTFY_TOPIC=homebase

# Optional. Stock CPython does not include SQLCipher; if this is set and
# SQLCipher is missing, HomeBase refuses to open the ledger.
# HOMEBASE_DB_KEY=

# Encrypted backups (restic + rclone). The password file must be mode 0600.
# Do not put the restic password in this file. See docs/backups.md.
# RESTIC_PASSWORD_FILE=/var/lib/homebase/restic-password
# RESTIC_REPOSITORY=rclone:gdrive:homebase-backups
# HOMEBASE_RCLONE_REMOTE=gdrive
# HOMEBASE_RECEIPTS_DIR=
# HOMEBASE_BACKUP_KEEP_DAILY=7
# HOMEBASE_BACKUP_KEEP_WEEKLY=4
# HOMEBASE_BACKUP_KEEP_MONTHLY=12
# HOMEBASE_BACKUP_READ_SUBSET=10%
# Second copy on a local disk or USB drive. Unset means off.
# HOMEBASE_BACKUP_LOCAL_REPOSITORY=

# Used only by `python -m homebase compose` services, which are off unless
# you start Docker with --profile later. Leave these commented until then.
# PIHOLE_WEBPASSWORD=
# IMMICH_DB_PASSWORD=
# IMMICH_DB_USER=immich
# IMMICH_DB_NAME=immich
# WIREGUARD_PEERS=
# WIREGUARD_PEER_DNS=
# WIREGUARD_SERVER_URL=
# TZ=UTC
